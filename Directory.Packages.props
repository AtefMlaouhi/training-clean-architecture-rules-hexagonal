<Project>
    <!-- 
    Central Package Management
    All package versions are managed centrally in this file.
    Individual projects reference packages without version numbers.
  -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>
    <ItemGroup Label="Core Packages">
        <!-- Error Handling -->
        <PackageVersion Include="ErrorOr" Version="2.1.1" />
        <!-- Entity Framework Core -->
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.8" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.8" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.8" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.8" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.8" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
        <!-- ASP.NET Core -->
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.5" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    </ItemGroup>
    <ItemGroup Label="Test Packages">
        <!-- Test Framework -->
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
        <PackageVersion Include="coverlet.collector" Version="6.0.4" />
        <!-- Testing Libraries -->
        <PackageVersion Include="FluentAssertions" Version="8.10.0" />
        <PackageVersion Include="NSubstitute" Version="5.3.0" />
        <PackageVersion Include="Bogus" Version="35.6.5" />
        <!-- Integration Testing -->
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.8" />
        <PackageVersion Include="Testcontainers" Version="4.12.0" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.12.0" />
        <!-- Architecture Testing -->
        <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
        <!-- Performance Testing -->
        <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
        <PackageVersion Include="BenchmarkDotNet.Diagnostics.Windows" Version="0.14.0" />
        <!-- Acceptance Testing (BDD) -->
        <PackageVersion Include="SpecFlow" Version="4.0.31-beta" />
        <PackageVersion Include="SpecFlow.xUnit" Version="4.0.31-beta" />
        <PackageVersion Include="Microsoft.Playwright" Version="1.50.0" />
        <!-- Stress/Load Testing -->
        <PackageVersion Include="NBomber" Version="6.0.2" />
        <PackageVersion Include="NBomber.Http" Version="6.0.2" />
    </ItemGroup>
</Project>